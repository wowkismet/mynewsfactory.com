# Copy to .env.local for development. Never commit a filled-in copy: only this
# example file belongs in the repository (§51).

# --- required -------------------------------------------------------------

# Public site origin, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=https://mynewsfactory.com

# PostgreSQL connection.
#
# TLS is required unless the connection string carries sslmode=disable, which
# is appropriate only for a database that is not reachable over a network --
# a local instance, or one on a private container network.
#
# Local development:
#   DATABASE_URL=postgres://mynewsfactory:devpassword@127.0.0.1:5432/mynewsfactory?sslmode=disable
#
# The application refuses to start if DATABASE_URL points at localhost while
# NODE_ENV=production.
DATABASE_URL=

# --- required by docker compose ------------------------------------------

# Compose refuses to start without this rather than defaulting to something
# guessable. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional; both default to "mynewsfactory".
# POSTGRES_USER=
# POSTGRES_DB=

# --- optional -------------------------------------------------------------

# Maximum pooled connections per process. Default 10.
# DATABASE_POOL_MAX=10
